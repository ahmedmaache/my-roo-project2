# LLM Provider Configuration
PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model Configuration
MODEL=gpt-4o-mini

# Rate Limiting
RATE_LIMIT_RPS=2

# Output Configuration
MAX_OUTPUT_TOKENS=2000

# Development Mode
DRY_RUN=false

# Cost Tracking (optional, set to actual values for cost estimation)
COST_PER_1K_INPUT=0.00
COST_PER_1K_OUTPUT=0.00

# Cost Budget
COST_BUDGET_USD=50

# Batch Processing
APP_INPUT_DIR=../../data/apps

# Slack Integration (optional)
SLACK_WEBHOOK_URL=

# === CRM Integration ===
AIRTABLE_BASE_ID=
AIRTABLE_TOKEN=
AIRTABLE_TABLE_APPS=Applications
AIRTABLE_TABLE_MENTORS=Mentors
AIRTABLE_TABLE_INVESTORS=Investors

GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# === Portal Publishing ===
PORTAL_DATA_DIR=../portal/public/data

# Privacy & Logging
GLOVEN_LOG_PII=false