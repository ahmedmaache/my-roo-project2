{
  "name": "@gloven/cli",
  "version": "1.0.0",
  "description": "AI-powered growth CLI for Gloven accelerator",
  "type": "module",
  "bin": {
    "gloven": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "gloven",
    "ai",
    "growth",
    "accelerator",
    "cli"
  ],
  "author": "Gloven",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "openai": "^4.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}